{
  "name": "@giulio-leone/lib-shared",
  "version": "0.6.0",
  "description": "OneCoach shared utilities, helpers, and services",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./id-generator": {
      "types": "./src/id-generator.ts",
      "default": "./src/id-generator.ts"
    },
    "./core-types": {
      "types": "./dist/core-types.d.ts",
      "import": "./dist/core-types.js",
      "require": "./dist/core-types.cjs"
    },
    "./storage.service": {
      "types": "./dist/storage.service.d.ts",
      "import": "./dist/storage.service.js",
      "require": "./dist/storage.service.cjs"
    },
    "./api.service": {
      "types": "./dist/api.service.d.ts",
      "import": "./dist/api.service.js",
      "require": "./dist/api.service.cjs"
    },
    "./date-utils": {
      "types": "./dist/date-utils.d.ts",
      "import": "./dist/date-utils.js",
      "require": "./dist/date-utils.cjs"
    },
    "./macro-calculations": {
      "types": "./dist/macro-calculations.d.ts",
      "import": "./dist/macro-calculations.js",
      "require": "./dist/macro-calculations.cjs"
    },
    "./prisma-type-guards": {
      "types": "./dist/prisma-type-guards.d.ts",
      "import": "./dist/prisma-type-guards.js",
      "require": "./dist/prisma-type-guards.cjs"
    },
    "./batch-processing": {
      "types": "./dist/batch-processing.d.ts",
      "import": "./dist/batch-processing.js",
      "require": "./dist/batch-processing.cjs"
    },
    "./simple-cache": {
      "types": "./dist/simple-cache.d.ts",
      "import": "./dist/simple-cache.js",
      "require": "./dist/simple-cache.cjs"
    },
    "./url-normalizer": {
      "types": "./dist/url-normalizer.d.ts",
      "import": "./dist/url-normalizer.js",
      "require": "./dist/url-normalizer.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.cjs"
    },
    "./utils/error": {
      "types": "./dist/utils/error/index.d.ts",
      "import": "./dist/utils/error/index.js",
      "require": "./dist/utils/error/index.cjs"
    },
    "./utils/error/*": {
      "types": "./dist/utils/error/*.d.ts",
      "import": "./dist/utils/error/*.js",
      "require": "./dist/utils/error/*.cjs"
    },
    "./utils/logger": {
      "types": "./dist/utils/logger/index.d.ts",
      "import": "./dist/utils/logger/index.js",
      "require": "./dist/utils/logger/index.cjs"
    },
    "./utils/logger/*": {
      "types": "./dist/utils/logger/*.d.ts",
      "import": "./dist/utils/logger/*.js",
      "require": "./dist/utils/logger/*.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "require": "./dist/hooks/*.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    },
    "./import-core": {
      "types": "./src/import-core/index.ts",
      "default": "./src/import-core/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/g97iulio1609/onecoach-shared.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@giulio-leone/types": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^7.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  }
}
